# DuForge Makhana — backend environment (copy to .env on the VPS, fill real values)
# NOTE: In the docker-compose stack, NODE_ENV, PORT and MONGO_URI are injected
# by compose (Mongo runs as a container), so you do NOT set MONGO_URI here.

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Email (OTP + admin order notifications) — Gmail requires an App Password
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
ADMIN_EMAIL=you@gmail.com

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx

# Optional: only for local/demo OTP testing — leave unset in production
# OTP_DEV_MODE=true
